// Prisma schema for the tournament-manager app.
//
// Connection notes:
//   DATABASE_URL points at the pooled Supabase endpoint used by the running
//   server (PgBouncer-friendly).
//   DIRECT_URL is the direct Postgres connection used by `prisma migrate` and
//   `prisma db push` — those operations don't work through the pooler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  firstName      String
  lastName       String
  profilePicture String?
  createdAt      DateTime @default(now())

  organizedTournaments Tournament[]  @relation("Organizer")
  participations       Participant[]

  @@map("users")
}

model Tournament {
  id              String           @id @default(uuid())
  title           String
  discipline      String
  locationName    String
  locationLat     Float
  locationLng     Float
  date            DateTime
  deadline        DateTime
  maxParticipants Int
  sponsorLogos    String[]
  status          TournamentStatus @default(OPEN)

  organizerId String
  organizer   User   @relation("Organizer", fields: [organizerId], references: [id])

  participants Participant[]
  matches      Match[]

  @@map("tournaments")
}

model Participant {
  id             String @id @default(uuid())
  licenseNumber  String
  currentRanking Int

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  matchesAsP1 Match[] @relation("Player1")
  matchesAsP2 Match[] @relation("Player2")
  matchesWon  Match[] @relation("Winner")

  // Each (license, ranking, user) is unique within a tournament. The DB is the
  // authority — application code translates P2002 violations into user-facing
  // messages instead of pre-checking.
  @@unique([tournamentId, licenseNumber])
  @@unique([tournamentId, currentRanking])
  @@unique([userId, tournamentId])
  @@map("participants")
}

model Match {
  id String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  // (round, position) addresses the slot in the bracket tree. position is
  // 1-indexed within the round. See src/lib/tournament/bracket.ts for the
  // pairing convention.
  round    Int
  position Int

  player1Id String?
  player1   Participant? @relation("Player1", fields: [player1Id], references: [id])

  player2Id String?
  player2   Participant? @relation("Player2", fields: [player2Id], references: [id])

  // player1Result / player2Result hold each player's *claim* about the winner.
  // When both agree, winnerId is set; on conflict, both are cleared so the
  // pair can re-vote (see lib/tournament/advance.ts).
  player1Result String?
  player2Result String?

  winnerId String?
  winner   Participant? @relation("Winner", fields: [winnerId], references: [id])

  @@map("matches")
}

enum TournamentStatus {
  OPEN
  LADDER_GENERATED
  COMPLETED
}
